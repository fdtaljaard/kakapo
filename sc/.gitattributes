# Keep the files as they are written: LF everywhere (Go, TypeScript, Markdown), CRLF only for the Windows script.
* text=auto eol=lf
*.ps1 text eol=crlf
*.png binary
*.jpg binary
*.m4a binary
*.woff2 binary
# Ola Hallengren's scripts are shipped byte for byte (CRLF, BOM): their SHA-256 is checked.
internal/domain/ola/*.sql -text
internal/domain/ola/LICENSE -text
